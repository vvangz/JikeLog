{
  "name": "jikelog",
  "private": true,
  "description": "即刻日志 JikeLog monorepo",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "lefthook install",
    "fonts": "bash scripts/fetch-fonts.sh",
    "tokens": "pnpm --filter @jikelog/design-tokens build",
    "gen:api": "bash scripts/gen-api.sh",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "lefthook": "2.2.0"
  }
}
