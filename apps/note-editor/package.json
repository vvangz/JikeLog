{
  "name": "@jikelog/note-editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "即刻日志笔记的富文本编辑器（Tiptap），构建为单个 HTML 文件，由 App 内的 WebView 加载（ADR-007）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "happy-dom": "20.14.6",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3"
  }
}
