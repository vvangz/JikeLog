{
  "name": "@jikelog/admin-web",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "即刻日志 Web 管理后台（只读查看用户配置信息）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
