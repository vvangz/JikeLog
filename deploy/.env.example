# 本地开发环境变量模板：复制为 deploy/.env 后按需修改（.env 已被 gitignore）
# 以下均为本地开发用的占位值，生产环境密钥只放在服务器或 CI Secrets 中。

POSTGRES_DB=jikelog
POSTGRES_USER=jikelog
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

REDIS_PASSWORD=change-me-local-only
# 本机 6379 已被占用时改为其他端口（如 6380），并同步修改下方 JIKELOG_REDIS_URL
REDIS_PORT=6379

# 本地 S3 兼容对象存储（RustFS），生产使用阿里云 OSS
S3_ACCESS_KEY=jikelog-local
S3_SECRET_KEY=change-me-local-only

# API 服务
JIKELOG_ENV=development
JIKELOG_HTTP_ADDR=127.0.0.1:8080
JIKELOG_LOG_LEVEL=debug
JIKELOG_LOG_FORMAT=text
JIKELOG_DB_URL=postgres://jikelog:change-me-local-only@127.0.0.1:5432/jikelog?sslmode=disable
JIKELOG_REDIS_URL=redis://:change-me-local-only@127.0.0.1:6379/0
# Access Token 签名密钥，至少 32 字节；生产环境用 openssl rand -base64 48 生成
JIKELOG_AUTH_JWT_SECRET=change-me-local-only-jwt-secret-0000
# 开发环境使用模拟短信（验证码打印在 API 日志中）且不做人机验证；staging / production 禁止这两项
JIKELOG_SMS_PROVIDER=mock
JIKELOG_CAPTCHA_PROVIDER=none
# 管理后台开发服务器地址（跨域白名单）
JIKELOG_HTTP_CORS_ORIGINS=http://localhost:5173

# 工作日志应用层传输加密（ADR-006）：服务端静态 X25519 私钥（base64，32 字节）。
# 下面是公开的开发示例密钥，App 调试包默认内置对应公钥；staging / production 禁止使用，配置校验会拒绝启动。
# 生成新密钥：openssl genpkey -algorithm X25519 -outform DER | tail -c 32 | base64
JIKELOG_E2E_PRIVATE_KEY=n8u4Sv4wcSFZAL1k17mtV7bg+ZhRoPOKQn/w5YPLLlM=
# 落库加密主密钥（base64，32 字节），生产环境在 v0.9.0 改用阿里云 KMS。生成：openssl rand -base64 32
JIKELOG_KMS_PROVIDER=local
JIKELOG_KMS_LOCAL_MASTER_KEY=v4jRZ7eVOKo/cCE83/e8RMzA3QKJmK4Dqj4hg52Fik4=

# 对象存储（附件）。开发环境启动时自动创建存储桶。
JIKELOG_STORAGE_ENDPOINT=http://127.0.0.1:9000
# 客户端直传直下使用的地址：Android 模拟器为 http://10.0.2.2:9000；
# 真机通过 adb reverse tcp:9000 tcp:9000 转发时为 http://127.0.0.1:9000
JIKELOG_STORAGE_PUBLIC_ENDPOINT=http://10.0.2.2:9000
JIKELOG_STORAGE_BUCKET=jikelog
JIKELOG_STORAGE_ACCESS_KEY=jikelog-local
JIKELOG_STORAGE_SECRET_KEY=change-me-local-only

# 备忘录提醒的服务端推送（ADR-008）：log 只记日志，提醒依赖 App 本地闹钟；开通极光后改为 jpush 并填写密钥
JIKELOG_PUSH_PROVIDER=log
# JIKELOG_PUSH_JPUSH_APP_KEY=
# JIKELOG_PUSH_JPUSH_MASTER_SECRET=
