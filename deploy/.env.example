# 本地开发环境变量模板：复制为 deploy/.env 后按需修改（.env 已被 gitignore）
# 以下均为本地开发用的占位值，生产环境密钥只放在服务器或 CI Secrets 中。

POSTGRES_DB=jikelog
POSTGRES_USER=jikelog
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

REDIS_PASSWORD=change-me-local-only
# 本机 6379 已被占用时改为其他端口（如 6380），并同步修改下方 JIKELOG_REDIS_URL
REDIS_PORT=6379

# 本地 S3 兼容对象存储（RustFS），生产使用阿里云 OSS
S3_ACCESS_KEY=jikelog-local
S3_SECRET_KEY=change-me-local-only

# API 服务
JIKELOG_ENV=development
JIKELOG_HTTP_ADDR=127.0.0.1:8080
JIKELOG_LOG_LEVEL=debug
JIKELOG_LOG_FORMAT=text
JIKELOG_DB_URL=postgres://jikelog:change-me-local-only@127.0.0.1:5432/jikelog?sslmode=disable
JIKELOG_REDIS_URL=redis://:change-me-local-only@127.0.0.1:6379/0
# Access Token 签名密钥，至少 32 字节；生产环境用 openssl rand -base64 48 生成
JIKELOG_AUTH_JWT_SECRET=change-me-local-only-jwt-secret-0000
# 开发环境使用模拟短信（验证码打印在 API 日志中）且不做人机验证；staging / production 禁止这两项
JIKELOG_SMS_PROVIDER=mock
JIKELOG_CAPTCHA_PROVIDER=none
# 管理后台开发服务器地址（跨域白名单）
JIKELOG_HTTP_CORS_ORIGINS=http://localhost:5173
