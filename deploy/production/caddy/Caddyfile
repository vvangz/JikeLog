# 即刻日志正式环境的入口（ADR-012、ADR-014）：一个域名承载官网、安装包下载、接口、管理后台与对象存储的预签名地址。
{
	email {$ACME_EMAIL}
	# 只向 Let's Encrypt 申请证书：App 正式版只信任 Let's Encrypt 的根证书
	cert_issuer acme
}

{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		# 全站不允许被嵌入（含 Caddy 自己返回的 404 页）；各路径另有自己的 CSP
		X-Frame-Options DENY
		-Server
	}

	# 接口（含 WebSocket 实时通知）与健康检查
	@api path /api/* /healthz /readyz
	handle @api {
		reverse_proxy api:8080
	}

	# 对象存储：附件与导出文件的预签名上传、下载。签名包含主机名，原样转发 Host
	@objects {
		path /{$STORAGE_BUCKET}/*
		method GET HEAD PUT
	}
	handle @objects {
		request_body {
			max_size 110MB
		}
		# 对象与管理后台同源：一律作为下载处理，即使上传时声明为 HTML 或 SVG，也不会在本域名下执行
		header {
			Content-Security-Policy "sandbox; default-src 'none'"
			Content-Disposition attachment
		}
		reverse_proxy objectstore:9000
	}

	# 管理后台：单页应用，找不到的路径回到 index.html
	handle_path /admin/* {
		root * /srv/admin/current
		header {
			Content-Security-Policy "frame-ancestors 'none'"
			X-Frame-Options DENY
			Referrer-Policy no-referrer
		}
		# 带哈希的静态资源长期缓存，找不到时返回 404（不能回落到 index.html 后被长期缓存）
		handle /assets/* {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		# 其余（index.html 与单页应用的路由）每次校验
		handle {
			header Cache-Control no-cache
			try_files {path} /index.html
			file_server
		}
	}

	redir /admin /admin/ 308

	# 安装包与下载清单 latest.json：发布时由部署工作流从 GitHub Release 取来、核对校验值后上传（ADR-014）
	handle_path /download/* {
		root * /srv/downloads/current
		header {
			X-Content-Type-Options nosniff
			Content-Security-Policy "sandbox; default-src 'none'"
		}
		@manifest path /latest.json
		header @manifest Cache-Control no-cache
		# 安装包一律作为下载处理；每次向服务器确认（重新发布同一版本时不会拿到旧文件）
		@packages path *.apk *.msix *.cer *.sha256
		header @packages {
			Content-Disposition attachment
			Cache-Control no-cache
		}
		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive
		@msix path *.msix
		header @msix Content-Type application/msix
		@cer path *.cer
		header @cer Content-Type application/pkix-cert
		file_server
	}

	# 官网（VitePress 生成的静态页面），其余路径都在这里。CSP 写在每个页面的 <meta> 中（按内联脚本的哈希放行），
	# 这里补上 <meta> 不支持的 frame-ancestors
	handle {
		root * /srv/site/current
		header {
			Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
			Referrer-Policy strict-origin-when-cross-origin
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
		}
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control no-cache
		# 地址不带 .html（/download → download.html，/guide/ → guide/index.html）
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	# Caddy 自己找不到文件时（官网、下载、管理后台的静态资源）显示官网的 404 页；
	# 接口与对象存储由上游返回的 404 原样转发，不经过这里。
	# 出错时站点级的 header 不再生效，而原路径设置的头会保留（如 /admin/assets/ 的长期缓存、安装包的类型），这里逐一改写
	handle_errors 404 {
		root * /srv/site/current
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Frame-Options DENY
			Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
			Content-Type "text/html; charset=utf-8"
			Cache-Control no-store
			-Content-Disposition
		}
		rewrite * /404.html
		file_server
	}
}

# 不带 www 的域名跳转到正式地址
{$SITE_DOMAIN_APEX} {
	redir https://{$SITE_DOMAIN}{uri} 308
}
