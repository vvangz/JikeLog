# 即刻日志正式环境的配置（ADR-012）。不要手工复制本文件：用 scripts/init-env.sh 生成 .env，
# 它会为所有机密生成随机值，并把权限设为 600。下面的值只说明格式。

# ───────── 版本与域名 ─────────
# 当前部署的版本，由 deploy.sh 维护
JIKELOG_VERSION=0.9.0
SITE_DOMAIN=www.pingvv.top
SITE_DOMAIN_APEX=pingvv.top
ACME_EMAIL=ops@example.com

# ───────── 数据库、缓存、对象存储（容器内部使用） ─────────
POSTGRES_PASSWORD=<随机>
REDIS_PASSWORD=<随机>
S3_ACCESS_KEY=<随机>
S3_SECRET_KEY=<随机>

# ───────── 服务端 ─────────
JIKELOG_ENV=production
JIKELOG_HTTP_ADDR=:8080
JIKELOG_HTTP_TRUSTED_PROXIES=172.30.0.0/24
JIKELOG_LOG_FORMAT=json
JIKELOG_DB_URL=postgres://jikelog:<POSTGRES_PASSWORD>@postgres:5432/jikelog?sslmode=disable
JIKELOG_REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
JIKELOG_AUTH_JWT_SECRET=<随机，至少 32 字节>
# 短信与推送暂未开通：只开放用户名密码登录，提醒只用本地闹钟
JIKELOG_SMS_PROVIDER=disabled
JIKELOG_CAPTCHA_PROVIDER=none
JIKELOG_PUSH_PROVIDER=log
# 传输加密私钥：对应的公钥需在构建 App 时通过 --dart-define=JIKELOG_E2E_PUBLIC_KEY 传入
JIKELOG_E2E_PRIVATE_KEY=<随机 X25519 私钥，base64>
# 单机环境用本地主密钥包裹各账号的数据密钥；它随加密备份保存，丢失后数据库中的敏感字段无法解开
JIKELOG_KMS_PROVIDER=local
JIKELOG_KMS_LOCAL_MASTER_KEY=<随机 32 字节，base64>
JIKELOG_STORAGE_ENDPOINT=http://objectstore:9000
JIKELOG_STORAGE_PUBLIC_ENDPOINT=https://www.pingvv.top
JIKELOG_STORAGE_BUCKET=jikelog
JIKELOG_STORAGE_PATH_STYLE=true
JIKELOG_STORAGE_ACCESS_KEY=<同 S3_ACCESS_KEY>
JIKELOG_STORAGE_SECRET_KEY=<同 S3_SECRET_KEY>

# ───────── 备份（每 14 天一次，见 docs/部署运维/备份与恢复.md） ─────────
BACKUP_INTERVAL_DAYS=14
BACKUP_KEEP=6
# age 公钥（age1 开头）。私钥由管理员离线保存，服务器上没有
BACKUP_AGE_RECIPIENT=
# 异地 OSS 的地址、存储桶与 AccessKey 不在本文件，而在 backup.env 中（只提供给 backup 服务）：
#   BACKUP_OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
#   BACKUP_OSS_BUCKET=
#   BACKUP_OSS_ACCESS_KEY_ID=
#   BACKUP_OSS_ACCESS_KEY_SECRET=
# OSS 上的旧备份默认由存储桶的生命周期规则删除；改为由备份脚本删除时设为 true（AccessKey 需要列出与删除权限）
BACKUP_OSS_PRUNE=false
